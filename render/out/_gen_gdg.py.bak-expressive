    # stretcher rung behind the legs, arrows in the gaps pointing at Policy
    rung_y = leg_bot - 92
    p.append(pill(span_x0 + 20, rung_y - 9, span_x1 - span_x0 - 40, 18, fill=violet_a(.22)))
