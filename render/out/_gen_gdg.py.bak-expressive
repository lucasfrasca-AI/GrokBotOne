    items = ["Native Git worktrees", "Built-in /grill-me", "Subagents", "/goal: run until the task is finished",
             "Scheduled tasks"]
    cx, cy = x + 28, y + 54
    rowh = 42
    for k, it in enumerate(items):
        iw = tw(it, "sans", 17, 600) + 30
        if cx + iw > x + w - 24:
            cx, cy = x + 28, cy + rowh
        p.append(pill(cx, cy, iw, 34, fill=PITCH, stroke=RULE, sw=1))
        p.append(T(cx + 15, cy + 23, it, 17, "sans", 600, BONE, tag=f"new-{k}"))
        cx += iw + 10
    p.append(T(x + w - 28, y + 38, "Also in 2.0: Agent Skills, MCP", 16, "sans", 400, MUTE, "end", tag="new-also"))
