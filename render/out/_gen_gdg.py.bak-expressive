def bubble_panel(x, y, w, h):
    """Hero: investment bubbles on a shared baseline, circle AREA proportional to A$ value.
    The A$29.9M AISI dot is drawn at the same true scale (r about 6px), so no 'not to scale' note."""
    p = [rrect(x, y, w, h, 44, fill=SURFACE, stroke=RULE, sw=1)]
    p.append(T(x + 36, y + 44, "WHO IS BUILDING HERE  \u00b7  CIRCLE AREA TO SCALE", 16, "mono", 600,
               VIOLET, ls=1.6, tag="bub-eyebrow"))
    R = 150.0                                 # A$20B
    r = lambda v: R * math.sqrt(v / 20000.0)  # value in A$M
    rA, rO, rM, rS = R, r(7000), r(5000), r(29.9)
    base = y + h - 26                         # shared baseline
    p.append(f'<line x1="{x + 36}" y1="{base + 0.75}" x2="{x + w - 36}" y2="{base + 0.75}" stroke="{RULE}" '
             f'stroke-width="1.5"/>')
    lab_top = y + 104                         # first label baseline for the small bubbles
    # AWS (hero bubble, labels inside)
    ax, ay = x + 36 + rA, base - rA
    p.append(f'<circle cx="{ax:.1f}" cy="{ay:.1f}" r="{rA:.1f}" fill="{VIOLET}"/>')
    p.append(big_num(ax, ay - 14, "A$20B", fs=60, fill=PITCH, anchor="middle", tag="aws-num"))
    p.append(T(ax, ay + 26, "AWS, 2025 to 2029", 20, "sans", 700, PITCH, "middle", tag="aws-who"))
    p.append(T(ax, ay + 66, "Source: Amazon and PM,", 16, "sans", 500, PITCH, "middle", tag="aws-src1"))
    p.append(T(ax, ay + 87, "14 Jun 2025", 16, "sans", 500, PITCH, "middle", tag="aws-src2"))

    def small(col_x, col_w, rad, fill, stroke, num, num_fs, lines, tag):
        q = []
        cx = col_x + rad
        cy = base - rad
        st = f' stroke="{stroke}" stroke-width="2"' if stroke else ""
        q.append(f'<circle cx="{cx:.1f}" cy="{cy:.1f}" r="{rad:.2f}" fill="{fill}"{st}/>')
        if num:
            q.append(big_num(cx, cy + num_fs * 0.34, num, fs=num_fs, fill=BONE, anchor="middle", tag=f"{tag}-num"))
        yy = lab_top
        for k, (txt, fs, wt, col) in enumerate(lines):
            if txt.startswith("#NUM "):
                q.append(big_num(col_x, yy, txt[5:], fs=fs, fill=col, tag=f"{tag}-big"))
                yy += 34
                continue
            q.append(T(col_x, yy, txt, fs, "sans", wt, col, tag=f"{tag}-{k}"))
            assert tw(txt, "sans", fs, wt) <= col_w, txt
            yy += 25 if fs >= 18 else 21
        return "\n".join(q), yy - 25, (cx, cy)

    c1 = ax + rA + 34
    s, last, _ = small(c1, 226, rO, violet_a(.62), None, "A$7B", 44, [
        ("OpenAI + NEXTDC", 21, 700, BONE), ("Sydney AI campus (MoU)", 18, 400, SUB),
        ("Source: Minister Charlton,", 16, 400, MUTE), ("5 Dec 2025", 16, 400, MUTE)], "oai")
    p.append(s)
    assert last + 24 < base - 2 * rO, "oai label hits bubble"
    c2 = c1 + 236
    s, last, _ = small(c2, 200, rM, violet_a(.30), VIOLET, "A$5B", 38, [
        ("Microsoft", 21, 700, BONE), ("Over two years", 18, 400, SUB),
        ("Source: Microsoft,", 16, 400, MUTE), ("24 Oct 2023", 16, 400, MUTE)], "ms")
    p.append(s)
    assert last + 24 < base - 2 * rM, "ms label hits bubble"
    # AISI column: dot at true scale on the baseline, label stack above
    c3 = c2 + 206
    cw3 = x + w - 36 - c3
    q = [big_num(c3, lab_top + 8, "A$29.9M", fs=40, fill=BONE, tag="aisi-num")]
    q.append(T(c3, lab_top + 44, "AI Safety Institute", 21, "sans", 700, BONE, tag="aisi-who"))
    s, last = para(c3, lab_top + 70, "Funded as mandatory guardrails were set aside", cw3, 18, 23, fill=SUB,
                   tag="aisi-body")
    q.append(s)
    s, last = para(c3, last + 26, "Source: National AI Plan, 2 Dec 2025", cw3, 16, 20, fill=MUTE, tag="aisi-src")
    q.append(s)
    dx, dy = c3 + 16, base - rS
    q.append(f'<circle cx="{dx:.1f}" cy="{dy:.2f}" r="{rS:.2f}" fill="{AMBER}"/>')
    q.append(f'<circle cx="{dx:.1f}" cy="{dy:.2f}" r="17" fill="none" stroke="{AMBER}" stroke-width="1.5" '
             f'stroke-dasharray="3 4"/>')
    q.append(T(dx + 30, dy + 6, "A$29.9M at the same scale", 16, "sans", 500, AMBER, tag="aisi-note"))
    assert last + 20 < dy - 20, "aisi stack hits dot"
    p += q
    return "\n".join(p)


def demand_cookie(x, y, w, h):
    """79% in a big cookie, 70% in an overlapping pill, shared source below."""
    p = []
    r, amp = 170, 8
    cx, cy = x + w / 2 + 6, y + r + amp
    p.append(cookie(cx, cy, r, n=14, amp=amp, fill=VIOLET))
    p.append(big_num(cx, cy - 38, "79%", fs=112, fill=PITCH, anchor="middle", tag="79"))
    lines = ["of Australian businesses say", "it's important their AI tools", "store and process data", "in Australia"]
    for i, ln in enumerate(lines):
        p.append(T(cx, cy + 6 + i * 24, ln, 20, "sans", 600, PITCH, "middle", tag=f"79-{i}"))
        half = tw(ln, "sans", 20, 600) / 2
        yy = cy + 6 + i * 24
        assert half < math.sqrt(r * r - (yy - cy) ** 2) - 18, ln
    # overlapping pill
    py, ph = cy + r - 52, 110
    p.append(pill(x, py, w, ph, fill=SURFACE2, stroke=VIOLET, sw=2))
    p.append(big_num(x + 34, py + ph / 2 + 21, "70%", fs=60, fill=BONE, tag="70"))
    tx = x + 34 + tw("70%", "mono", 60, 700) + 22
    s, _ = para(tx, py + ph / 2 - 4, "would pay more for AI hosted entirely in Australia",
                x + w - 36 - tx, 19, 24, fill=BONE, tag="70-body")
    p.append(s)
    assert cy + 6 + 3 * 24 + 8 < py, "cookie text under pill"
    s, last = para(x + 8, py + ph + 30,
                   "Source: Decidr, State of AI in Australian Business 2026, 1,324 businesses, Jul 2026. "
                   "Vendor survey; Decidr's David Brudenell was on the panel.", w - 16, 16, 21, fill=MUTE,
                   tag="decidr-src")
    p.append(s)
    assert last < y + h, f"decidr source overflows ({last} > {y + h})"
    return "\n".join(p)


def stat_shape(x, y, w, h, shape, chip_txt, num, unit, body, src, num_fs=76, hi=False):
    p = []
    if shape == "squircle":
        p.append(squircle(x, y, w, h, 4.2, fill=SURFACE2 if hi else SURFACE, stroke=RULE, sw=1))
        pad = 34
    else:
        p.append(rrect(x, y, w, h, 48, fill=SURFACE, stroke=RULE, sw=1))
        pad = 30
    s, cwid = chip(x + pad, y + 22, chip_txt, tag=f"chip-{num}")
    p.append(s)
    nb = y + 22 + 30 + 14 + 0.72 * num_fs
    p.append(big_num(x + pad, nb, num, unit, fs=num_fs, fill=BONE, unit_fill=SUB))
    s, last = para(x + pad, nb + 32, body, w - 2 * pad, 18, 23, fill=SUB, tag=f"body-{num}")
    p.append(s)
    src_lines = wrap_px(src, w - 2 * pad, "sans", 16)
    sy = y + h - 26 - (len(src_lines) - 1) * 20
    for i, ln in enumerate(src_lines):
        p.append(T(x + pad, sy + i * 20, ln, 16, "sans", 400, MUTE, tag=f"src-{num}-{i}"))
    if last + 28 > sy:
        WARN.append(f"stat {num}: body {last:.0f} too close to source {sy:.0f}")
    return "\n".join(p)


def date_pill(x, y, w, h):
    p = [pill(x, y, w, h, fill=SURFACE, stroke=RULE, sw=1)]
    r = h / 2 - 16
    cx, cy = x + 16 + r, y + h / 2
