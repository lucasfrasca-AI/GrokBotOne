#!/usr/bin/env python3
"""Generate six CCAR-F reference-card SVGs (1200x1200 dark brand)."""
from pathlib import Path
from xml.sax.saxutils import escape

OUT = Path("/workspace/render/out")
W = H = 1200

PITCH = "#05010E"
BONE = "#F3F3F1"
SUB = "#D4D2CE"
MUTE = "#A4A098"
VIOLET = "#A855F7"
INDIGO = "#6366F1"
AMBER = "#FCD34D"
ACCENT = "#895AF6"
SURFACE = "#160F24"
SURFACE2 = "#1C1528"
INPUT = "#1B122B"
RULE = "rgba(243,243,241,.12)"

SANS = "Geist, ui-sans-serif, system-ui, sans-serif"
MONO = "Geist Mono, ui-monospace, SFMono-Regular, Menlo, monospace"

# same-dir href: rsvg on this box will not load ../ relative images
MARK = "lf-mark.png"


def esc(t: str) -> str:
    t = t.replace("\u2014", "-").replace("\u2013", "-").replace("—", "-").replace("–", "-")
    t = t.replace("\u2192", "->").replace("→", "->")
    return escape(t, {"'": "&apos;", '"': "&quot;"})


def spectrum_bar(x, y, w, h=4):
    gid = f"spec{abs(hash((x, y, w))) % 10**8}"
    return f'''
  <defs>
    <linearGradient id="{gid}" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="{INDIGO}"/>
      <stop offset="50%" stop-color="{VIOLET}"/>
      <stop offset="100%" stop-color="{AMBER}"/>
    </linearGradient>
  </defs>
  <rect x="{x}" y="{y}" width="{w}" height="{h}" rx="{h/2}" fill="url(#{gid})"/>'''


def chip(x, y, text, kind="mute"):
    colors = {
        "mute": (INPUT, MUTE),
        "violet": ("rgba(168,85,247,.18)", VIOLET),
        "indigo": ("rgba(99,102,241,.18)", INDIGO),
        "amber": ("rgba(252,211,77,.15)", AMBER),
        "accent": ("rgba(137,90,246,.18)", ACCENT),
    }
    bg, fg = colors.get(kind, colors["mute"])
    # mono ~9.6px avg glyph at 14px
    tw = max(54, int(len(text) * 9.6 + 24))
    th = 30
    return (
        f'<rect x="{x}" y="{y}" width="{tw}" height="{th}" rx="7" fill="{bg}"/>'
        f'<text x="{x + 12}" y="{y + 20}" font-family="{MONO}" font-size="14" '
        f'fill="{fg}" font-weight="500">{esc(text)}</text>',
        tw + 8,
    )


def chips_row(x, y, items, max_w=520):
    parts = []
    cx, cy = x, y
    row_h = 36
    for text, kind in items:
        frag, step = chip(cx, cy, text, kind)
        if cx + step - 8 > x + max_w and cx > x:
            cx = x
            cy += row_h
            frag, step = chip(cx, cy, text, kind)
        parts.append(frag)
        cx += step
    return "\n".join(parts), (cy - y) + 28


def card_box(x, y, w, h, rx=14):
    return (
        f'<rect x="{x}" y="{y}" width="{w}" height="{h}" rx="{rx}" '
        f'fill="{SURFACE}" stroke="{RULE}" stroke-width="1"/>'
    )


def lf_mark(x=36, y=1108, width=72):
    height = width * 144 / 154
    return (
        f'<image href="{MARK}" xlink:href="{MARK}" x="{x}" y="{y}" width="{width}" '
        f'height="{height:.1f}" preserveAspectRatio="xMidYMid meet"/>'
    )


def footer(cite, mark_y=1108):
    return f'''
  {lf_mark(36, mark_y, 72)}
  <text x="1164" y="{mark_y + 44}" text-anchor="end" font-family="{SANS}"
        font-size="14" fill="{MUTE}">{esc(cite)}</text>
'''


def wrap_text(text, max_chars):
    words = text.split()
    lines, cur = [], []
    for w in words:
        trial = " ".join(cur + [w])
        if len(trial) <= max_chars:
            cur.append(w)
        else:
            if cur:
                lines.append(" ".join(cur))
            cur = [w]
    if cur:
        lines.append(" ".join(cur))
    return lines


def render_std_card(x, y, w, h, c):
    parts = [card_box(x, y, w, h)]
    pad = 18
    parts.append(
        f'<text x="{x + pad}" y="{y + 30}" font-family="{MONO}" font-size="16" '
        f'fill="{VIOLET}" font-weight="600">{esc(c["n"])}</text>'
    )
    parts.append(
        f'<text x="{x + pad}" y="{y + 60}" font-family="{SANS}" font-size="25" '
        f'fill="{BONE}" font-weight="650">{esc(c["title"])}</text>'
    )
    def_lines = wrap_text(c["def"], 38 if w < 520 else 44)
    dy = y + 90
    for line in def_lines[:2]:
        parts.append(
            f'<text x="{x + pad}" y="{dy}" font-family="{SANS}" font-size="17" '
            f'fill="{SUB}">{esc(line)}</text>'
        )
        dy += 23
    chip_y = dy + 8
    chip_svg, chip_h = chips_row(x + pad, chip_y, c["chips"], max_w=w - 2 * pad - 4)
    parts.append(chip_svg)
    cons_lines = wrap_text(c["cons"], 42 if w < 520 else 48)
    cons_y = y + h - 18 - (len(cons_lines[:2]) - 1) * 18
    # keep below chips
    min_cons = chip_y + chip_h + 14
    if cons_y < min_cons:
        cons_y = min(min_cons, y + h - 18)
    for i, line in enumerate(cons_lines[:2]):
        parts.append(
            f'<text x="{x + pad}" y="{cons_y + i * 18}" font-family="{SANS}" font-size="15" '
            f'fill="{AMBER}">{esc(line)}</text>'
        )
    return "\n".join(parts)


def wrap_svg(inner: str) -> str:
    return f'''<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
     width="1200" height="1200" viewBox="0 0 1200 1200">
  <rect width="1200" height="1200" fill="{PITCH}"/>
{inner}
</svg>
'''


def gen_g1():
    """Exam Overview: banded hierarchy (title -> format -> scenarios -> domains)."""
    cite = "Exam Guide v1.0 / Anthropic (facts)"
    parts = []
    parts.append(spectrum_bar(48, 36, 260, 4))
    parts.append(
        f'<text x="48" y="70" font-family="{MONO}" font-size="14" fill="{VIOLET}"'
        f' letter-spacing="1.6" font-weight="600">CCAR-F  ·  REFERENCE</text>'
    )
    parts.append(
        f'<text x="48" y="112" font-family="{SANS}" font-size="40" fill="{BONE}"'
        f' font-weight="700">CCAR-F Exam Overview</text>'
    )
    parts.append(
        f'<text x="48" y="144" font-family="{SANS}" font-size="17" fill="{SUB}">'
        f'Claude Certified Architect - Foundations</text>'
    )
    parts.append(
        f'<text x="48" y="168" font-family="{MONO}" font-size="14" fill="{MUTE}">'
        f'Exam Guide v1.0</text>'
    )

    # --- Format facts strip ---
    fx, fy, fw, fh = 36, 188, 1128, 118
    parts.append(card_box(fx, fy, fw, fh, rx=14))
    parts.append(
        f'<text x="{fx + 22}" y="{fy + 32}" font-family="{MONO}" font-size="13" '
        f'fill="{VIOLET}" font-weight="600">FORMAT</text>'
    )
    facts = [
        ("60 Q", "violet"),
        ("120 min", "indigo"),
        ("pass 720", "violet"),
        ("$125", "amber"),
        ("closed book", "mute"),
        ("partner-only Pearson", "indigo"),
        ("12 months", "mute"),
    ]
    # seven equal mini-cards across the strip
    pad = 18
    gap_f = 10
    inner_w = fw - 2 * pad
    cell_w = (inner_w - 6 * gap_f) // 7
    cell_y = fy + 48
    cell_h = 52
    for i, (label, kind) in enumerate(facts):
        colors = {
            "mute": (INPUT, MUTE),
            "violet": ("rgba(168,85,247,.18)", VIOLET),
            "indigo": ("rgba(99,102,241,.18)", INDIGO),
            "amber": ("rgba(252,211,77,.15)", AMBER),
        }
        bg, fg = colors[kind]
        cx = fx + pad + i * (cell_w + gap_f)
        parts.append(
            f'<rect x="{cx}" y="{cell_y}" width="{cell_w}" height="{cell_h}" '
            f'rx="10" fill="{bg}"/>'
        )
        # center label
        parts.append(
            f'<text x="{cx + cell_w/2:.1f}" y="{cell_y + 32}" text-anchor="middle" '
            f'font-family="{MONO}" font-size="13" fill="{fg}" font-weight="600">'
            f'{esc(label)}</text>'
        )

    # --- Scenario structure band ---
    sx, sy, sw, sh = 36, 322, 1128, 120
    parts.append(card_box(sx, sy, sw, sh, rx=14))
    parts.append(
        f'<text x="{sx + 22}" y="{sy + 32}" font-family="{MONO}" font-size="13" '
        f'fill="{AMBER}" font-weight="600">SCENARIO STRUCTURE</text>'
    )
    parts.append(
        f'<text x="{sx + 22}" y="{sy + 62}" font-family="{SANS}" font-size="20" '
        f'fill="{BONE}" font-weight="600">4 of 6 themes on a form · ~15 items each</text>'
    )
    chip_svg, _ = chips_row(
        sx + 22,
        sy + 80,
        [("community note", "amber"), ("scenarios = dressing", "violet"), ("mechanisms recur", "mute")],
        max_w=1080,
    )
    parts.append(chip_svg)

    # --- Domains grouped block ---
    dx, dy = 36, 458
    dw = 1128
    # section chrome
    domains = [
        ("D1", "27%", "Agentic Architecture & Orchestration", "violet"),
        ("D2", "18%", "Tool Design & MCP Integration", "indigo"),
        ("D3", "20%", "Claude Code Configuration & Workflows", "violet"),
        ("D4", "20%", "Prompt Engineering & Structured Output", "indigo"),
        ("D5", "15%", "Context Management & Reliability", "amber"),
    ]
    footer_top = 1105
    avail = footer_top - dy - 8
    # header band inside domains group
    hdr_h = 44
    gap_d = 10
    row_h = (avail - hdr_h - 4 * gap_d) // 5
    group_h = hdr_h + 5 * row_h + 4 * gap_d
    parts.append(card_box(dx, dy, dw, group_h, rx=16))
    parts.append(
        f'<text x="{dx + 22}" y="{dy + 30}" font-family="{MONO}" font-size="13" '
        f'fill="{VIOLET}" font-weight="600">FIVE DOMAINS  ·  WEIGHTS</text>'
    )
    # weight sum hint right
    parts.append(
        f'<text x="{dx + dw - 22}" y="{dy + 30}" text-anchor="end" font-family="{MONO}" '
        f'font-size="13" fill="{MUTE}">100%</text>'
    )

    # max weight for bar scale
    max_pct = 27
    for i, (dn, pct, name, kind) in enumerate(domains):
        colors = {
            "violet": VIOLET,
            "indigo": INDIGO,
            "amber": AMBER,
        }
        accent = colors[kind]
        ry = dy + hdr_h + i * (row_h + gap_d)
        # inner row surface
        parts.append(
            f'<rect x="{dx + 14}" y="{ry}" width="{dw - 28}" height="{row_h}" '
            f'rx="12" fill="{INPUT}"/>'
        )
        parts.append(
            f'<rect x="{dx + 14}" y="{ry}" width="5" height="{row_h}" rx="2" fill="{accent}"/>'
        )
        # D label + big %
        mid_y = ry + row_h / 2
        parts.append(
            f'<text x="{dx + 36}" y="{mid_y + 6:.1f}" font-family="{MONO}" font-size="18" '
            f'fill="{accent}" font-weight="700">{dn}</text>'
        )
        parts.append(
            f'<text x="{dx + 86}" y="{mid_y + 8:.1f}" font-family="{MONO}" font-size="28" '
            f'fill="{BONE}" font-weight="700">{pct}</text>'
        )
        parts.append(
            f'<text x="{dx + 190}" y="{mid_y + 7:.1f}" font-family="{SANS}" font-size="20" '
            f'fill="{BONE}" font-weight="600">{esc(name)}</text>'
        )
        # weight bar at right
        bar_max_w = 160
        pct_n = int(pct.rstrip("%"))
        bar_w = int(bar_max_w * pct_n / max_pct)
        bar_x = dx + dw - 28 - 18 - bar_max_w
        bar_y = mid_y - 5
        parts.append(
            f'<rect x="{bar_x}" y="{bar_y:.1f}" width="{bar_max_w}" height="10" '
            f'rx="5" fill="rgba(243,243,241,.08)"/>'
        )
        parts.append(
            f'<rect x="{bar_x}" y="{bar_y:.1f}" width="{bar_w}" height="10" '
            f'rx="5" fill="{accent}"/>'
        )

    parts.append(footer(cite, 1105))
    return wrap_svg("\n".join(parts))


def gen_g2():
    cite = "Exam Guide v1.0 §4 · Anthropic"
    domains = [
        {
            "n": "D1 · 27%",
            "title": "Agentic Architecture & Orchestration",
            "bullets": [
                "Drive loop on stop_reason: continue tool_use; stop end_turn",
                "Hub-spoke coordinator + parallel Task; explicit context pass",
            ],
            "chips": [("hooks/gates", "violet"), ("money/irreversible", "amber")],
            "cons": "Highest weight - orchestration judgment dominates.",
        },
        {
            "n": "D2 · 18%",
            "title": "Tool Design & MCP Integration",
            "bullets": [
                "Differentiating tool descriptions; fix names before routers",
                ".mcp.json team + ${ENV}; ~/.claude.json personal",
            ],
            "chips": [("Grep=contents", "indigo"), ("Glob=paths", "mute")],
            "cons": "Wrong tool -> improve descriptions first.",
        },
        {
            "n": "D3 · 20%",
            "title": "Claude Code Configuration & Workflows",
            "bullets": [
                "Project CLAUDE.md for team standards (not user-level)",
                ".claude/rules paths globs; CI -p/--print + json schema",
            ],
            "chips": [("skills fork", "violet"), ("plan vs direct", "mute")],
            "cons": "Shared on clone -> project paths; CI hang -> -p.",
        },
        {
            "n": "D4 · 20%",
            "title": "Prompt Engineering & Structured Output",
            "bullets": [
                "tool_use + JSON schema for guaranteed shape",
                "tool_choice auto / any / forced; batches if latency-tolerant",
            ],
            "chips": [("validation-retry", "indigo"), ("nullable/enum", "mute")],
            "cons": "Blocking pre-merge -> sync Messages API, not batches.",
        },
        {
            "n": "D5 · 15%",
            "title": "Context Management & Reliability",
            "bullets": [
                "Persist exact facts in a case-facts block",
                "Escalate on human ask / policy gap - not sentiment",
            ],
            "chips": [("trim tool out", "amber"), ("lost-in-middle", "mute")],
            "cons": "Key findings at start/end; trim verbose tool output.",
        },
    ]
    head = f'''
  {spectrum_bar(48, 36, 260, 4)}
  <text x="48" y="72" font-family="{MONO}" font-size="14" fill="{VIOLET}"
        letter-spacing="1.6" font-weight="600">CCAR-F  ·  CHEAT</text>
  <text x="48" y="116" font-family="{SANS}" font-size="40" fill="{BONE}"
        font-weight="700">Five Domains</text>
  <text x="48" y="148" font-family="{SANS}" font-size="17" fill="{SUB}">Weights and pass reflexes from Exam Guide §4</text>
'''
    body_top = 168
    margin_x = 36
    gap = 12
    avail = 1092 - body_top
    card_h = (avail - 4 * gap) // 5
    parts = [head]
    for i, d in enumerate(domains):
        y = body_top + i * (card_h + gap)
        x = margin_x
        w = W - 2 * margin_x
        parts.append(card_box(x, y, w, card_h, rx=12))
        accent = VIOLET if i % 2 == 0 else INDIGO
        parts.append(
            f'<rect x="{x}" y="{y}" width="5" height="{card_h}" rx="2" fill="{accent}"/>'
        )
        pad = 22
        # number on left, title wraps beside/below
        parts.append(
            f'<text x="{x + pad}" y="{y + 30}" font-family="{MONO}" font-size="16" '
            f'fill="{VIOLET}" font-weight="600">{esc(d["n"])}</text>'
        )
        parts.append(
            f'<text x="{x + pad + 118}" y="{y + 30}" font-family="{SANS}" font-size="21" '
            f'fill="{BONE}" font-weight="650">{esc(d["title"])}</text>'
        )
        by = y + 56
        for b in d["bullets"]:
            parts.append(
                f'<text x="{x + pad}" y="{by}" font-family="{SANS}" font-size="16" '
                f'fill="{SUB}">· {esc(b)}</text>'
            )
            by += 24
        chip_svg, _ = chips_row(x + pad, by + 2, d["chips"], max_w=720)
        parts.append(chip_svg)
        parts.append(
            f'<text x="{x + w - pad}" y="{y + card_h - 16}" text-anchor="end" '
            f'font-family="{SANS}" font-size="14" fill="{AMBER}">{esc(d["cons"])}</text>'
        )
    parts.append(footer(cite, 1105))
    return wrap_svg("\n".join(parts))


def gen_g3():
    cite = "Exam Guide / Anthropic docs (hit-list)"
    terms = [
        {
            "n": "01",
            "title": "stop_reason",
            "def": "Continue on tool_use; stop on end_turn.",
            "chips": [("max_tokens", "mute"), ("pause_turn", "mute"), ("refusal", "mute")],
            "cons": "Never end the loop by parsing assistant prose.",
        },
        {
            "n": "02",
            "title": "tool_choice",
            "def": "auto / any / tool+name / none.",
            "chips": [("auto", "indigo"), ("any", "violet"), ("forced", "amber")],
            "cons": "Force named tool for mandatory first step, then auto.",
        },
        {
            "n": "03",
            "title": "Hooks",
            "def": "PreToolUse can block; PostToolUse after; PreCompact before compact.",
            "chips": [("PreToolUse", "violet"), ("PostToolUse", "mute"), ("PreCompact", "mute")],
            "cons": "Money / irreversible -> PreToolUse gate, not a stronger prompt.",
        },
        {
            "n": "04",
            "title": "MCP paths",
            "def": "Team .mcp.json + ${ENV}; personal ~/.claude.json.",
            "chips": [(".mcp.json", "indigo"), ("~/.claude.json", "mute")],
            "cons": "Shared on clone -> project file; secrets via ${ENV_VAR}.",
        },
        {
            "n": "05",
            "title": "CLAUDE.md",
            "def": "~/.claude/ personal; project .claude/CLAUDE.md or root shared.",
            "chips": [("team=project", "violet"), ("personal", "mute")],
            "cons": "Team standards live in project CLAUDE.md, not user-level.",
        },
        {
            "n": "06",
            "title": "CLI CI",
            "def": "-p / --print non-interactive; --output-format json.",
            "chips": [("-p/--print", "amber"), ("json schema", "mute")],
            "cons": "Reject invented flags like CLAUDE_HEADLESS or --batch.",
        },
        {
            "n": "07",
            "title": "Grep vs Glob",
            "def": "Grep searches contents; Glob matches path patterns.",
            "chips": [("Grep=contents", "indigo"), ("Glob=paths", "violet")],
            "cons": "Incremental explore: Grep -> Read matches. Never Read-all.",
        },
        {
            "n": "08",
            "title": "Batches vs sync",
            "def": "Batches ~50% cheaper, up to 24h; no multi-turn tools.",
            "chips": [("~50% cheaper", "amber"), ("sync if blocking", "violet")],
            "cons": "Blocking / pre-merge -> sync Messages API.",
        },
    ]
    head = f'''
  {spectrum_bar(48, 36, 240, 4)}
  <text x="48" y="72" font-family="{MONO}" font-size="14" fill="{VIOLET}"
        letter-spacing="1.6" font-weight="600">CCAR-F  ·  MEMORISE</text>
  <text x="48" y="116" font-family="{SANS}" font-size="40" fill="{BONE}"
        font-weight="700">Terms Hit-List</text>
  <text x="48" y="148" font-family="{SANS}" font-size="17" fill="{SUB}">Paths, flags, and API params until reflexive</text>
'''
    body_top = 168
    margin_x = 36
    gap = 12
    col_w = (W - 2 * margin_x - gap) // 2
    avail = 1090 - body_top
    row_h = (avail - 3 * gap) // 4
    parts = [head]
    for i, c in enumerate(terms):
        col = i % 2
        row = i // 2
        x = margin_x + col * (col_w + gap)
        y = body_top + row * (row_h + gap)
        parts.append(render_std_card(x, y, col_w, row_h, c))
    parts.append(footer(cite, 1105))
    return wrap_svg("\n".join(parts))


def gen_g4():
    """Scenario Mechanics: core rule + constraints + six themes + mechanism triggers."""
    cite = "Exam Guide v1.0 / Anthropic (facts)"
    parts = []
    parts.append(spectrum_bar(48, 36, 260, 4))
    parts.append(
        f'<text x="48" y="68" font-family="{MONO}" font-size="14" fill="{VIOLET}"'
        f' letter-spacing="1.6" font-weight="600">CCAR-F  ·  SCENARIOS</text>'
    )
    parts.append(
        f'<text x="48" y="108" font-family="{SANS}" font-size="36" fill="{BONE}"'
        f' font-weight="700">Scenario Mechanics</text>'
    )
    parts.append(
        f'<text x="48" y="136" font-family="{SANS}" font-size="16" fill="{SUB}">'
        f'4 of 6 appear · stories change, mechanisms repeat</text>'
    )

    # --- Core rule ---
    x, y, w, h = 36, 152, 1128, 118
    parts.append(card_box(x, y, w, h, rx=14))
    parts.append(f'<rect x="{x}" y="{y}" width="6" height="{h}" fill="{AMBER}"/>')
    parts.append(
        f'<text x="{x + 28}" y="{y + 32}" font-family="{MONO}" font-size="13" '
        f'fill="{AMBER}" font-weight="600">CORE RULE</text>'
    )
    parts.append(
        f'<text x="{x + 28}" y="{y + 64}" font-family="{SANS}" font-size="22" '
        f'fill="{BONE}" font-weight="650">Money / safety / must -> hooks, gates, schemas,</text>'
    )
    parts.append(
        f'<text x="{x + 28}" y="{y + 92}" font-family="{SANS}" font-size="22" '
        f'fill="{BONE}" font-weight="650">forced tool_choice.  Not stronger prompts.</text>'
    )

    # --- Constraint words ---
    x2, y2, w2, h2 = 36, 284, 1128, 92
    parts.append(card_box(x2, y2, w2, h2, rx=14))
    parts.append(
        f'<text x="{x2 + 22}" y="{y2 + 28}" font-family="{MONO}" font-size="13" '
        f'fill="{VIOLET}" font-weight="600">FIND THE CONSTRAINT WORD FIRST</text>'
    )
    constraints = [
        ("latency", "indigo"),
        ("shared vs personal", "violet"),
        ("blocking", "amber"),
        ("guaranteed", "violet"),
        ("must / always", "amber"),
    ]
    chip_svg, _ = chips_row(x2 + 22, y2 + 42, constraints, max_w=1080)
    parts.append(chip_svg)
    parts.append(
        f'<text x="{x2 + 22}" y="{y2 + 82}" font-family="{SANS}" font-size="14" '
        f'fill="{MUTE}">That word usually kills three options. Scenarios = dressing.</text>'
    )

    # --- Six official themes (compact 2x3) ---
    themes = [
        ("01", "Customer Support Resolution Agent"),
        ("02", "Code Generation with Claude Code"),
        ("03", "Multi-Agent Research System"),
        ("04", "Developer Productivity with Claude"),
        ("05", "Claude Code for CI"),
        ("06", "Structured Data Extraction"),
    ]
    tx0, ty0 = 36, 390
    tw = 1128
    # section label as thin band
    parts.append(
        f'<text x="{tx0 + 4}" y="{ty0 + 18}" font-family="{MONO}" font-size="13" '
        f'fill="{MUTE}" font-weight="600">SIX OFFICIAL THEMES  ·  4 appear</text>'
    )
    theme_top = ty0 + 28
    gap = 10
    col_w = (tw - gap) // 2
    theme_h = 52
    for i, (n, title) in enumerate(themes):
        col = i % 2
        row = i // 2
        tx = tx0 + col * (col_w + gap)
        ty = theme_top + row * (theme_h + gap)
        parts.append(card_box(tx, ty, col_w, theme_h, rx=10))
        parts.append(
            f'<text x="{tx + 16}" y="{ty + 32}" font-family="{MONO}" font-size="15" '
            f'fill="{VIOLET}" font-weight="700">{n}</text>'
        )
        parts.append(
            f'<text x="{tx + 52}" y="{ty + 32}" font-family="{SANS}" font-size="16" '
            f'fill="{BONE}" font-weight="600">{esc(title)}</text>'
        )

    # --- Mechanism trigger cards (5) ---
    mech_label_y = theme_top + 3 * (theme_h + gap) + 8
    parts.append(
        f'<text x="{tx0 + 4}" y="{mech_label_y}" font-family="{MONO}" font-size="13" '
        f'fill="{MUTE}" font-weight="600">MECHANISM TRIGGERS</text>'
    )
    mechs = [
        {
            "n": "01",
            "title": "PreToolUse vs PostToolUse",
            "body": "Pre can block. Post is after; cannot undo.",
            "chips": [("Pre=block", "violet"), ("Post=after", "mute")],
        },
        {
            "n": "02",
            "title": "Team MCP vs personal",
            "body": ".mcp.json + ${ENV} shared. ~/.claude.json personal.",
            "chips": [(".mcp.json", "indigo"), ("~/.claude.json", "mute")],
        },
        {
            "n": "03",
            "title": "Batches vs sync API",
            "body": "~50% cheaper, <=24h, no multi-turn tools.",
            "chips": [("batches", "amber"), ("sync if blocking", "violet")],
        },
        {
            "n": "04",
            "title": "Grep vs Glob",
            "body": "Grep = file contents. Glob = path patterns.",
            "chips": [("Grep=contents", "indigo"), ("Glob=paths", "violet")],
        },
        {
            "n": "05",
            "title": "CI hang",
            "body": "Use -p / --print for non-interactive runs.",
            "chips": [("-p / --print", "amber")],
        },
    ]
    mx0 = 36
    my0 = mech_label_y + 12
    footer_top = 1105
    avail = footer_top - my0 - 6
    # 3 on first row, 2 on second (or 5 equal columns?)
    # Better: row of 3 + row of 2 spanning, or 5 in a row is too cramped at 390.
    # Use 3 top + 2 bottom with wider bottom cards.
    gap_m = 10
    row1_n = 3
    row1_w = (1128 - 2 * gap_m) // 3
    row2_w = (1128 - gap_m) // 2
    row_h = (avail - gap_m) // 2

    def mech_card(mx, my, mw, mh, m):
        out = [card_box(mx, my, mw, mh, rx=12)]
        out.append(
            f'<text x="{mx + 16}" y="{my + 28}" font-family="{MONO}" font-size="14" '
            f'fill="{VIOLET}" font-weight="700">{m["n"]}</text>'
        )
        out.append(
            f'<text x="{mx + 16}" y="{my + 54}" font-family="{SANS}" font-size="17" '
            f'fill="{BONE}" font-weight="650">{esc(m["title"])}</text>'
        )
        # wrap body
        lines = wrap_text(m["body"], 28 if mw < 400 else 36)
        by = my + 78
        for line in lines[:2]:
            out.append(
                f'<text x="{mx + 16}" y="{by}" font-family="{SANS}" font-size="14" '
                f'fill="{SUB}">{esc(line)}</text>'
            )
            by += 18
        chip_s, _ = chips_row(mx + 16, my + mh - 42, m["chips"], max_w=mw - 32)
        out.append(chip_s)
        return "\n".join(out)

    for i, m in enumerate(mechs[:3]):
        mx = mx0 + i * (row1_w + gap_m)
        parts.append(mech_card(mx, my0, row1_w, row_h, m))
    my1 = my0 + row_h + gap_m
    for i, m in enumerate(mechs[3:]):
        mx = mx0 + i * (row2_w + gap_m)
        parts.append(mech_card(mx, my1, row2_w, row_h, m))

    parts.append(footer(cite, 1105))
    return wrap_svg("\n".join(parts))


def gen_g5():
    cite = "Pass directives §5 · Exam Guide §8"
    steps = [
        {
            "n": "01",
            "title": "Read Exam Guide v1.0",
            "def": "End-to-end; self-score each task red/amber/green.",
            "chips": [("blueprint", "violet")],
            "cons": "Six scenarios, samples, appendix, out-of-scope.",
        },
        {
            "n": "02",
            "title": "Drill hit-list (§3)",
            "def": "Paths, flags, stop_reason, tool_choice, hooks.",
            "chips": [("rote layer", "amber")],
            "cons": "Until reflexive - this is where many lose points.",
        },
        {
            "n": "03",
            "title": "Hands-on Ex1",
            "def": "Multi-tool + structured errors + PreToolUse gate + escalate.",
            "chips": [("Guide §8", "indigo")],
            "cons": "Gate money/identity; escalate on human ask.",
        },
        {
            "n": "04",
            "title": "Hands-on Ex2",
            "def": "CLAUDE.md + rules globs + skill fork + .mcp.json.",
            "chips": [("project scope", "violet")],
            "cons": "Team config in project; ${ENV} for secrets.",
        },
        {
            "n": "05",
            "title": "Hands-on Ex3",
            "def": "Extraction schema + validation-retry + batches trial.",
            "chips": [("nullable/enum", "mute")],
            "cons": "Batches only when latency-tolerant.",
        },
        {
            "n": "06",
            "title": "Hands-on Ex4",
            "def": "Coordinator + parallel Task + explicit context pass.",
            "chips": [("hub-spoke", "indigo")],
            "cons": "Subagents inherit nothing - you pass findings.",
        },
        {
            "n": "07",
            "title": "Domain deep-dive",
            "def": "Weight order D1 -> D3/D4 -> D2 -> D5 + Academy tracks.",
            "chips": [("27% first", "violet")],
            "cons": "Official docs over unofficial dumps.",
        },
        {
            "n": "08",
            "title": "Timed mock + night-before",
            "def": "Closed-book 60/120; night-before hit-list only.",
            "chips": [("no new material", "amber")],
            "cons": "Map every miss to a mechanism, not a letter.",
        },
    ]
    head = f'''
  {spectrum_bar(48, 36, 240, 4)}
  <text x="48" y="72" font-family="{MONO}" font-size="14" fill="{VIOLET}"
        letter-spacing="1.6" font-weight="600">CCAR-F  ·  PREP</text>
  <text x="48" y="116" font-family="{SANS}" font-size="40" fill="{BONE}"
        font-weight="700">Prep Sequence</text>
  <text x="48" y="148" font-family="{SANS}" font-size="17" fill="{SUB}">Eight ordered steps (compressed from the full study sequence)</text>
'''
    body_top = 168
    margin_x = 36
    gap = 12
    col_w = (W - 2 * margin_x - gap) // 2
    avail = 1090 - body_top
    row_h = (avail - 3 * gap) // 4
    parts = [head]
    for i, c in enumerate(steps):
        col = i % 2
        row = i // 2
        x = margin_x + col * (col_w + gap)
        y = body_top + row * (row_h + gap)
        parts.append(render_std_card(x, y, col_w, row_h, c))
    parts.append(footer(cite, 1105))
    return wrap_svg("\n".join(parts))


def gen_g6():
    cite = "Exam Guide v1.0 sample questions (Anthropic)"
    head = f'''
  {spectrum_bar(48, 36, 260, 4)}
  <text x="48" y="72" font-family="{MONO}" font-size="14" fill="{AMBER}"
        letter-spacing="1.6" font-weight="600">PRACTICE / SAMPLE  ·  EXAM GUIDE</text>
  <text x="48" y="116" font-family="{SANS}" font-size="36" fill="{BONE}"
        font-weight="700">Good Practice Quiz</text>
  <text x="48" y="148" font-family="{SANS}" font-size="16" fill="{SUB}">Q1 Customer Support · Official sample - not live exam</text>
'''
    parts = [head]
    x, y, w, h = 36, 168, 1128, 210
    parts.append(card_box(x, y, w, h, rx=14))
    parts.append(
        f'<text x="{x + 24}" y="{y + 34}" font-family="{MONO}" font-size="14" '
        f'fill="{VIOLET}" font-weight="600">STEM</text>'
    )
    stem = (
        "Production data shows that in 12% of cases, your agent skips get_customer "
        "entirely and calls lookup_order using only the customer's stated name, "
        "occasionally leading to misidentified accounts and incorrect refunds. "
        "What change would most effectively address this reliability issue?"
    )
    lines = wrap_text(stem, 76)
    sy = y + 68
    for line in lines:
        parts.append(
            f'<text x="{x + 24}" y="{sy}" font-family="{SANS}" font-size="18" '
            f'fill="{BONE}">{esc(line)}</text>'
        )
        sy += 28

    options = [
        ("A", True,
         "Programmatic prerequisite blocking lookup_order / process_refund until get_customer returns verified ID"),
        ("B", False,
         "Enhance system prompt that get_customer is mandatory"),
        ("C", False,
         "Few-shot always calling get_customer first"),
        ("D", False,
         "Routing classifier enabling tool subsets"),
    ]
    body_top = 398
    margin_x = 36
    gap = 12
    # leave room for WHY (90) + mark (~80) + padding
    why_h = 86
    mark_zone = 95
    avail = 1200 - body_top - why_h - mark_zone - gap - 8
    opt_h = (avail - 3 * gap) // 4
    for i, (letter, ok, text) in enumerate(options):
        oy = body_top + i * (opt_h + gap)
        border = AMBER if ok else RULE
        fill = "rgba(252,211,77,.08)" if ok else SURFACE
        sw = "2.5" if ok else "1"
        parts.append(
            f'<rect x="{margin_x}" y="{oy}" width="{W - 2*margin_x}" height="{opt_h}" '
            f'rx="12" fill="{fill}" stroke="{border}" stroke-width="{sw}"/>'
        )
        parts.append(
            f'<text x="{margin_x + 24}" y="{oy + opt_h/2 + 7:.0f}" font-family="{MONO}" '
            f'font-size="24" fill="{AMBER if ok else VIOLET}" font-weight="700">{letter}</text>'
        )
        olines = wrap_text(text, 68)
        total_h = len(olines[:2]) * 26
        start_y = oy + (opt_h - total_h) / 2 + 20
        for j, line in enumerate(olines[:2]):
            parts.append(
                f'<text x="{margin_x + 62}" y="{start_y + j * 26:.0f}" font-family="{SANS}" '
                f'font-size="17" fill="{BONE}" font-weight="{"650" if ok else "400"}">{esc(line)}</text>'
            )
        if ok:
            parts.append(
                f'<text x="{W - margin_x - 28}" y="{oy + opt_h/2 + 7:.0f}" text-anchor="end" '
                f'font-family="{MONO}" font-size="14" fill="{AMBER}" font-weight="600">CORRECT</text>'
            )

    wy = body_top + 4 * (opt_h + gap)
    parts.append(card_box(36, wy, 1128, why_h, rx=12))
    parts.append(
        f'<text x="60" y="{wy + 32}" font-family="{MONO}" font-size="14" '
        f'fill="{AMBER}" font-weight="600">WHY A</text>'
    )
    parts.append(
        f'<text x="60" y="{wy + 60}" font-family="{SANS}" font-size="17" '
        f'fill="{SUB}">Money/identity sequence needs a deterministic gate; prompts are probabilistic.</text>'
    )

    parts.append(footer(cite, 1108))
    return wrap_svg("\n".join(parts))


def check_bad(s: str, name: str):
    for ch in ("\u2014", "\u2013", "—", "–"):
        if ch in s:
            raise SystemExit(f"dash found in {name}: {ch!r}")


def main():
    gens = [
        ("ccarf-exam-overview", gen_g1),
        ("ccarf-domains-cheat", gen_g2),
        ("ccarf-terms-cheat", gen_g3),
        ("ccarf-scenario-cheat", gen_g4),
        ("ccarf-prep-sequence", gen_g5),
        ("ccarf-good-quiz", gen_g6),
    ]
    for name, fn in gens:
        svg = fn()
        check_bad(svg, name)
        path = OUT / f"{name}.svg"
        path.write_text(svg)
        print(f"wrote {path}")


if __name__ == "__main__":
    main()
