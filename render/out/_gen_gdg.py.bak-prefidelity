def gen_stats():
    start_page()
    p = []
    # ---- hero: bubble cluster, circle AREA proportional to A$
    R = 256.0
    r = lambda v: R * math.sqrt(v / 20000.0)
    rA, rO, rM, rS = R, r(7000), r(5000), r(29.9)
    ax, ay = MARGIN + 50 + rA, 478
