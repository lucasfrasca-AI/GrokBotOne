                f'<stop offset="0.6" stop-color="{BONE}" stop-opacity="0.6"/>'
                f'<stop offset="1" stop-color="{BONE}" stop-opacity="0"/></radialGradient>')
    DEFS.append(f'<mask id="{mid}"><rect x="{cx - r:.0f}" y="{cy - r:.0f}" width="{2 * r:.0f}" height="{2 * r:.0f}" '
